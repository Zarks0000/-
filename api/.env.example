API_HOST=0.0.0.0
API_PORT=80
DATABASE_URL=postgresql://mototravel:change-me@127.0.0.1:5432/mototravel
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=8
POSTGRES_POOL_WAIT_SECONDS=5
POSTGRES_CONNECT_TIMEOUT=5

AMAP_WEB_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
WEATHER_API_KEY=
WEATHER_JWT=
WEATHER_API_HOST=api.qweather.com
TAVILY_API_KEY=
NEWS_API_KEY=
WECHAT_APPID=
WECHAT_APP_SECRET=
# 本地联调没有真实微信小程序密钥时可临时设为 1；正式环境必须关闭。
WECHAT_AUTH_MOCK=0
WECHAT_API_VERIFY_SSL=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
FEEDBACK_BCC_TO_SENDER=1

