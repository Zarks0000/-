API_HOST=0.0.0.0
API_PORT=80
DATABASE_URL=postgresql://mototravel:change-me@127.0.0.1:5432/mototravel
# Supabase PostgreSQL 连接串。配置后优先于 DATABASE_URL；建议使用 Session pooler 或 Direct connection，并保留 sslmode=require。
# 示例：SUPABASE_DATABASE_URL=postgresql://postgres.xxxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=8
POSTGRES_POOL_WAIT_SECONDS=5
POSTGRES_CONNECT_TIMEOUT=5

AMAP_WEB_API_KEY=
AMAP_GEOCODE_TIMEOUT=4
AMAP_ROUTE_TIMEOUT=6
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# 新建行程默认不用同步大模型，避免创建接口超时；如需创建时生成 AI 提醒再设为 1。
ROUTE_PLAN_USE_LLM=0
WEATHER_API_KEY=
WEATHER_JWT=
WEATHER_API_HOST=api.qweather.com
NEWS_API_KEY=
WECHAT_APPID=
WECHAT_APP_SECRET=
# 本地联调没有真实微信小程序密钥时可临时设为 1；正式环境必须关闭。
WECHAT_AUTH_MOCK=0
WECHAT_API_VERIFY_SSL=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
FEEDBACK_BCC_TO_SENDER=1

# QQ Mail example:
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=your_qq_email@qq.com
# SMTP_PASSWORD=your_smtp_authorization_code
# SMTP_FROM=your_qq_email@qq.com
# SMTP_USE_TLS=1
# FEEDBACK_BCC_TO_SENDER=1
